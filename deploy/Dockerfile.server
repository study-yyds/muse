# Muse server 镜像（NestJS + ffmpeg + 中文字体）
# 构建：docker compose -f deploy/docker-compose.yml build server
# 启动入口自动跑 drizzle 迁移（幂等），再起服务

# ---------- 构建阶段 ----------
FROM node:22-slim AS build
WORKDIR /app
RUN npm install -g pnpm@11
# ffmpeg-static 的 postinstall 默认从 GitHub Releases 下载 ffmpeg 二进制，
# 国内网络直连 GitHub 被拒（ECONNREFUSED），改走 npmmirror 镜像
ENV FFMPEG_BINARIES_URL=https://registry.npmmirror.com/-/binary/ffmpeg-static
# 先拷贝 workspace 清单安装依赖（利用 Docker 层缓存）
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY shared/package.json shared/
COPY client/package.json client/
COPY server/package.json server/
RUN pnpm install --frozen-lockfile
# 全量源码构建：先删陈旧的 tsbuildinfo 增量缓存——它随 git 打包进来，
# tsc 增量模式会据此漏 emit 文件（曾导致 dist 缺 crypto.util.js 启动即崩）
COPY . .
RUN rm -f server/tsconfig.build.tsbuildinfo server/tsconfig.tsbuildinfo \
  && pnpm --filter @muse/server build

# ---------- 运行阶段 ----------
FROM node:22-slim
ENV NODE_ENV=production \
    TZ=Asia/Shanghai \
    PORT=3004

# 中文字体（promo 卡片 drawtext 用）；ffmpeg 由 ffmpeg-static npm 包自带，无需 apt 安装
RUN apt-get update \
  && apt-get install -y --no-install-recommends fonts-noto-cjk \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# pnpm workspace 依赖（.pnpm 存储 + 符号链接整体拷贝，保持相对链接有效）
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/server/node_modules /app/server/node_modules
COPY --from=build /app/server/package.json /app/server/package.json
COPY --from=build /app/server/dist /app/server/dist
# public 初始内容（uploads 由 volume 挂载覆盖）
COPY --from=build /app/server/public /app/server/public

EXPOSE 3004
# 注：数据库 schema 由开发侧手动维护（无自动化迁移，server/drizzle 目录不存在），
# 此处直接启动；DATABASE_URL 指向现有 Neon 库
CMD ["sh", "-c", "cd /app/server && exec node dist/main.js"]
