# ============ Muse 生产环境变量（复制为 deploy/.env 并填写）============

# Neon PostgreSQL 连接串（postgres://user:pass@host/db?sslmode=require）
DATABASE_URL=

# 32 字节 hex，用于用户 API key 的 AES-256-GCM 加密。
# 生成：openssl rand -hex 32
# 警告：一旦有用户存过 API key 就不能再改，否则已存的 key 全部解不开
ENCRYPTION_KEY=

# JWT 签名密钥（登录态签发用），本地 server/.env 里有，直接复制同样的值
JWT_SECRET=

# AI 主平台（DeepSeek 等，deepseek-chat / deepseek-reasoner 模型）
AI_PLATFORM_KEY=
AI_PLATFORM_BASE_URL=https://api.deepseek.com/v1

# 通义千问（qwen 系列模型路由用）
QWEN_API_KEY=
QWEN_BASE_URL=

# 图像生成
VOLCANO_IMAGE_KEY=
QWEN_IMAGE_URL=

# 火山引擎 TTS（promo 视频配音；素材包模式不生成音频，可不填）
VOLCANO_TTS_KEY=

# 服务端口（容器内固定 3004，Nginx 反代依赖此值，不要改）
PORT=3004
