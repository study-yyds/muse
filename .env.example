# ============ 数据库 ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/muse

# ============ AI 平台 Key ============
AI_PLATFORM_KEY=sk-your-platform-key
AI_PLATFORM_BASE_URL=https://api.deepseek.com/v1
AI_PLATFORM_MODEL=deepseek-chat

# ============ 安全 ============
# 32字节 hex 字符串，用于加密用户自定义 API Key
# 生成方式: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-random-32-byte-hex-string

# ============ JWT ============
JWT_SECRET=change-me-to-a-random-secret

# ============ 服务端口 ============
PORT=3001

# ============ 短信服务（V2 接入） ============
# SMS_PROVIDER=aliyun
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
